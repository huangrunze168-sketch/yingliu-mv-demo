{
  "name": "xiaoq-tv",
  "version": "0.3.0",
  "description": "小QTV —— 以 前置内核 为前置内核的可控复刻与局部修复工作站",
  "author": "期音科技",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev:api": "tsx apps/local-api/src/server.ts",
    "dev:web": "corepack pnpm --filter @qiyin/web dev",
    "cli": "tsx apps/cli/src/index.ts",
    "check": "tsc --noEmit",
    "check:web": "corepack pnpm --filter @qiyin/web check",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "corepack pnpm check && corepack pnpm check:web && corepack pnpm test"
  },
  "devDependencies": {
    "@fastify/sensible": "^6.0.3",
    "@types/node": "^24.10.0",
    "fastify": "^5.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8",
    "zod": "^4.1.12"
  }
}
