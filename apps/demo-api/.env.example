# 复制为 /etc/yingliu-demo-api.env（生产）或在当前终端设置后启动。
# 不要把真实密钥提交到 Git。
MODELSNEXUS_BASE=https://modelsnexus.org
MODELSNEXUS_API_KEY=
MINIMAX_API_KEY=
IMAGE_API_KEY=

DEEPSEEK_BASE=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# DSH Headless 是 Agent 主后端。required 表示 DSH 失败时不静默降级；
# auto 表示开发环境未安装 DSH 时回退到直接 DeepSeek 调用。
DSH_AGENT_MODE=required
DSH_COMMAND=/usr/local/bin/dsh
DSH_HOME=/var/lib/yingliu-demo/dsh
DSH_TIMEOUT_SECONDS=900
# dsh-video-lens 使用与 DeepSeek 相同的视觉接口；生产环境可改为独立视频视觉模型密钥。
VIDEO_LENS_API_KEY=

YINGLIU_DEMO_HOST=127.0.0.1
YINGLIU_DEMO_PORT=8791
YINGLIU_DEMO_DATA=/var/lib/yingliu-demo/jobs
YINGLIU_DEMO_PROJECTS_FILE=/var/lib/yingliu-demo/projects.json
YINGLIU_DEMO_PUBLIC_PREFIX=/yingliu-demo-results
# ModelsNexus 拉取本地素材所需的公网 API 地址。生产环境必须使用受信任证书的 HTTPS，
# 不要填写纯 HTTP IP；Seedance 上游可能因此返回 fail_to_fetch_task / 502。
# 例如：https://demo.example.com/yingliu-demo-api
YINGLIU_DEMO_PUBLIC_API_BASE=
YINGLIU_DEMO_MAX_UPLOAD=314572800
YINGLIU_DEMO_MAX_DURATION=60
YINGLIU_DEMO_JOB_TTL=86400
